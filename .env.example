# Base URLs
# KOMIKDEBE_BASE_URL=https://komikdebe.vercel.app
# NEXT_PUBLIC_KOMIKDEBE_BASE_URL=https://komikdebe.vercel.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_MIRROR_BASE_URL=https://westmanga.tv
# Optional: default mirror source for `/latest?type=mirror` and the Home "Mirror Updates" section.
# MIRROR_LATEST_SOURCE=ryzukomik
# NEXT_PUBLIC_MIRROR_LATEST_SOURCE=ryzukomik

# Image proxy allowlist (comma-separated). If empty, all hosts are allowed.
# KOMIK_PROXY_ALLOWED_HOSTS=minio-prod-2.komikcast.to,assets.shngm.id,storage.westmanga.tv,storage.westmanga.blog,westmanga.blog
#
# Optional: spoof headers to bypass hotlink protection (use with care).
# KOMIK_PROXY_REFERER=https://ryzukomik.my.id/
# KOMIK_PROXY_REFERER_HOSTS=storage.westmanga.blog,storage.westmanga.tv
# KOMIK_PROXY_USER_AGENT=

# Discord notifier (server-only)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_SECRET=

# Supabase (client + sync helper)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
